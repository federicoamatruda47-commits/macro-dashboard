<!doctype html>
{# =====================================================================
   Struttura comune a tutte le pagine (Jinja2): testata, menu a due righe, piede.
   Ogni pagina riempie i blocchi "contenuto" e (se ha grafici) "script_grafici".
   {{ radice }} è il prefisso relativo per tornare alla radice del sito ("", "../", ...).
   {{ css_colori }} contiene i colori fissi dei Paesi, letti da config.yaml (blocco "colori").
   ===================================================================== #}
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block titolo %}Macro dashboard{% endblock %}</title>
  <meta name="description" content="{% block descrizione %}Macroeconomic dashboard updated every day: rates, yield curves, inflation, credit, equities, currencies and commodities.{% endblock %}">
  {# ?v=... cambia a ogni generazione: il browser scarica sempre il CSS aggiornato #}
  <link rel="stylesheet" href="{{ radice }}style.css?v={{ versione }}">
  <style>{{ css_colori|safe }}</style>
</head>
<body{% if id_pagina == 'home' %} data-home{% endif %}>
  {# ---- Testata e menu: restano in cima mentre si scorre ---- #}
  <header class="testata-sito">
    <div class="contenitore">
      <a class="marchio" href="{{ radice or './' }}">Macro dashboard</a>
      <nav class="menu" aria-label="Main menu">
        <ul class="menu-riga">
          {% for v in menu %}
          <li><a href="{{ v.href }}"{% if v.attiva %} aria-current="page"{% endif %}>{{ v.titolo }}</a></li>
          {% endfor %}
        </ul>
        {% if sottomenu %}
        <ul class="menu-riga menu-sotto" aria-label="Pages in this section">
          {% for v in sottomenu %}
          <li><a href="{{ v.href }}"{% if v.attiva %} aria-current="page"{% endif %}>{{ v.titolo }}</a></li>
          {% endfor %}
        </ul>
        {% endif %}
      </nav>
    </div>
  </header>

  <main class="contenitore">
    {% block contenuto %}{% endblock %}
  </main>

  <footer class="piede contenitore">
    <p>Data: Federal Reserve Bank of St. Louis (FRED), including the ICE BofA, Moody's, CBOE and NBER series published there;
      European Central Bank (ECB Data Portal); Yahoo Finance (futures and index prices, unofficial source);
      International Monetary Fund via FRED (monthly fallback prices); Bank for International Settlements (BIS: policy rates and inflation);
      Japan Ministry of Finance (JGB yields); Statistics Bureau of Japan (via DBnomics: Japan CPI); OECD via FRED (Korea 10-year yield);
      euro-area recession dates: CEPR-EABCN Euro Area Business Cycle Dating Committee.
      This dashboard is for study purposes and is not financial advice.</p>
  </footer>

  {% block script_grafici %}{% endblock %}
  <script src="{{ radice }}app.js?v={{ versione }}"></script>
</body>
</html>
