{% extends "base.html.j2" %}
{% from "_componenti.html.j2" import avvisi, riepilogo, tabella_performance, scheda_grafico %}
{# Pagina del sito (Markets, Economies...): titolo, una riga, avvisi, "Key numbers", sezioni con grafici; se non è attiva, "coming soon" #}

{% block titolo %}{{ r.nome }} · Macro dashboard{% endblock %}
{% block descrizione %}{{ r.descrizione }}{% endblock %}

{% block contenuto %}
<section class="intestazione-pagina">
  <h1>{{ r.nome }}</h1>
  {% if r.descrizione %}<p class="descrizione">{{ r.descrizione }}</p>{% endif %}
  <p class="aggiornamento">Updated <strong>{{ aggiornato }}</strong></p>
  {% if r.attiva and r.ancore|length > 1 %}
  <ul class="chips" aria-label="On this page">
    {% for a in r.ancore %}<li><a href="#{{ a.id }}">{{ a.titolo }}</a></li>{% endfor %}
  </ul>
  {% endif %}
</section>

{{ avvisi(r.errori, r.in_ritardo, r.riserve, r.totale_serie, " series used on this page", radice) }}

{% if not r.attiva %}
<div class="in-arrivo">
  <h2>Coming soon</h2>
  <p>This page is being prepared. Meanwhile, the <a href="{{ radice }}markets/">Markets</a> pages already compare rates, credit, equities,
    currencies and commodities across these economies.</p>
</div>
{% else %}
{# ---- Numeri chiave (solo se la pagina ne ha) ---- #}
{% if r.riepilogo %}{{ riepilogo(r) }}{% endif %}

{# ---- Sezioni con i grafici ---- #}
{% for sez in r.sezioni %}
<section class="blocco" id="{{ r.slug }}-{{ sez.id }}" aria-labelledby="titolo-{{ r.slug }}-{{ sez.id }}">
  <h2 id="titolo-{{ r.slug }}-{{ sez.id }}">{{ sez.titolo }}</h2>
  {% if sez.descrizione %}<p class="descrizione">{{ sez.descrizione }}</p>{% endif %}
  {% if sez.performance %}{{ tabella_performance(sez) }}{% endif %}
  {% if sez.grafici %}
  <div class="griglia-grafici">
    {% for g in sez.grafici %}{{ scheda_grafico(g, radice) }}{% endfor %}
  </div>
  {% endif %}
</section>
{% endfor %}

{% endif %}

{% if r.precedente or r.successivo %}
<nav class="pagina-vicina" aria-label="Neighbouring pages">
  {% if r.precedente %}<a class="precedente" href="{{ r.precedente.href }}">‹ <span>Previous</span> {{ r.precedente.nome }}</a>{% else %}<span></span>{% endif %}
  {% if r.successivo %}<a class="successivo" href="{{ r.successivo.href }}"><span>Next</span> {{ r.successivo.nome }} ›</a>{% endif %}
</nav>
{% endif %}
<p class="descrizione">Every series on this site, with its source and status: <a href="{{ radice }}method/series/">Series status</a>.
  Sources, rules and known limits: <a href="{{ radice }}method/">Sources &amp; method</a>.</p>
{% endblock %}

{% block script_grafici %}
{% if r.ha_grafici %}
<script src="https://cdn.plot.ly/plotly-basic-{{ plotly_versione }}.min.js" charset="utf-8"></script>
{% endif %}
{% endblock %}
