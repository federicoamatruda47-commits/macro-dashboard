{% extends "base.html.j2" %}
{% from "_componenti.html.j2" import avvisi %}
{# Home provvisoria (step 1): elenco delle pagine e avvisi su tutte le serie. Dallo step 6 diventa la Panoramica. #}

{% block contenuto %}
<section class="intestazione-pagina">
  <h1>Macro dashboard</h1>
  <p class="descrizione">A static macroeconomic dashboard, rebuilt every day. Choose a page.</p>
  <p class="aggiornamento">Updated <strong>{{ aggiornato }}</strong> · data sources: FRED, ECB, BIS, Yahoo Finance, Japan Ministry of Finance and Statistics Bureau of Japan</p>
</section>

{{ avvisi(errori, in_ritardo, riserve, totale_serie, "", radice) }}

<section class="blocco" aria-labelledby="pagine">
  <h2 id="pagine">Pages</h2>
  <div class="griglia-kpi griglia-pagine">
    {% for p in regioni %}
    <a class="scheda-pagina" href="{{ p.id }}/">
      <h3>{{ p.nome }}{% if not p.attiva %} <span class="presto">coming soon</span>{% endif %}</h3>
      <p>{{ p.descrizione }}</p>
      <p class="kpi-data">{{ p.n_grafici }} charts</p>
    </a>
    {% endfor %}
  </div>
</section>
{% endblock %}
