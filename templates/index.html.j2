<!doctype html>
{# =====================================================================
   Modello della pagina (Jinja2). Le parti tra {{ }} e {% %} vengono
   riempite da dashboard/render.py con i dati scaricati.
   ===================================================================== #}
<html lang="it">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard macro</title>
  <meta name="description" content="Dashboard macroeconomica aggiornata ogni giorno: tassi, curva, inflazione, credito.">
  {# ?v=... cambia a ogni generazione: il browser scarica sempre il CSS aggiornato #}
  <link rel="stylesheet" href="style.css?v={{ versione }}">
</head>
<body>
  <header class="testata">
    <div class="contenitore">
      <h1>Dashboard macro</h1>
      <p class="aggiornamento">Aggiornata il <strong>{{ aggiornato }}</strong> · fonti dati: FRED, BCE e Yahoo Finance</p>
    </div>
  </header>

  {# ---- Tab delle regioni ---- #}
  <nav class="tab-barra" aria-label="Regioni">
    <div class="contenitore tab-lista" role="tablist">
      {% for r in regioni %}
      <button class="tab" role="tab" id="tab-{{ r.id }}" aria-controls="pannello-{{ r.id }}"
              data-regione="{{ r.id }}" aria-selected="{{ 'true' if loop.first else 'false' }}">
        {{ r.nome }}{% if not r.attiva %} <span class="presto">in arrivo</span>{% endif %}
      </button>
      {% endfor %}
    </div>
  </nav>

  <main class="contenitore">
    {# ---- Avvisi globali: serie non scaricate o in ritardo ---- #}
    {% if errori %}
    <div class="avviso avviso-errore" role="alert">
      <strong>⚠ Attenzione: {{ errori|length }} {{ 'serie non è stata scaricata' if errori|length == 1 else 'serie non sono state scaricate' }}</strong>
      (su {{ totale_serie }}). Il resto della dashboard è aggiornato.
      <ul>
        {% for e in errori %}<li><code>{{ e.id }}</code> {{ e.nome }}: {{ e.errore }}</li>{% endfor %}
      </ul>
    </div>
    {% endif %}
    {# Controllo di freschezza: la serie si scarica senza errori ma non riceve dati nuovi da troppo tempo
       (può voler dire che la fonte l'ha dismessa o sostituita) #}
    {% if in_ritardo %}
    <div class="avviso avviso-ritardo" role="alert">
      <strong>⚠ Attenzione: {{ in_ritardo|length }} {{ 'serie non riceve' if in_ritardo|length == 1 else 'serie non ricevono' }} dati nuovi da troppo tempo</strong>
      (soglie: 10 giorni per le giornaliere, 21 per le settimanali, 75 per le mensili, 120 per le trimestrali,
      contati dalla fine del periodo dell'ultimo dato). Controllare che la fonte non sia cambiata.
      <ul>
        {% for s in in_ritardo %}<li>{{ s.regione }} · <code>{{ s.id }}</code> {{ s.nome }}: ultimo dato {{ s.data }}, serie {{ s.frequenza }}, {{ s.giorni }} giorni (soglia {{ s.soglia }})</li>{% endfor %}
      </ul>
    </div>
    {% endif %}
    {% if riserve %}
    <div class="avviso avviso-riserva">
      <strong>ⓘ Fonte di riserva in uso</strong> per {{ riserve|length }} {{ 'serie' }}: i dati sono comunque aggiornati.
      <ul>
        {% for s in riserve %}<li><code>{{ s.id }}</code> {{ s.nome }}: {{ s.nota }}</li>{% endfor %}
      </ul>
    </div>
    {% endif %}

    {% for r in regioni %}
    <section class="pannello" id="pannello-{{ r.id }}" role="tabpanel" aria-labelledby="tab-{{ r.id }}"
             {% if not loop.first %}hidden{% endif %}>
      {% if not r.attiva %}
      <div class="in-arrivo">
        <h2>{{ r.nome }}</h2>
        <p>Questa sezione è in preparazione e arriverà nelle prossime fasi del progetto.</p>
      </div>
      {% else %}

      {# ---- Scheda riassuntiva (solo se la regione ha serie con riepilogo: true) ---- #}
      {% if r.riepilogo %}
      <section class="blocco" aria-labelledby="riepilogo-{{ r.id }}">
        <h2 id="riepilogo-{{ r.id }}">In sintesi</h2>
        <p class="descrizione">Ultimo valore e variazione rispetto a 1 settimana, 1 mese e 1 anno prima.
          Tassi in punti base (pb = 0,01%), inflazione in punti percentuali (pp), indici in %.</p>
        <div class="griglia-kpi">
          {% for k in r.riepilogo %}
          <article class="kpi{% if not k.ok %} kpi-errore{% endif %}">
            <h3>{{ k.nome }}</h3>
            {% if k.ok %}
            <p class="kpi-valore">{{ k.valore }}</p>
            <p class="kpi-data{% if k.ritardo %} in-ritardo{% endif %}">al {{ k.data }}{% if k.ritardo %} · in ritardo{% endif %}</p>
            <dl class="kpi-variazioni">
              {% for v in k.variazioni %}
              <div><dt>{{ v.etichetta }}</dt><dd>{{ v.testo }}</dd></div>
              {% endfor %}
            </dl>
            {% else %}
            <p class="kpi-valore">n.d.</p>
            <p class="kpi-data">⚠ {{ k.errore }}</p>
            {% endif %}
          </article>
          {% endfor %}
        </div>
      </section>
      {% endif %}

      {# ---- Sezioni con i grafici ---- #}
      {% for sez in r.sezioni %}
      <section class="blocco" id="{{ r.id }}-{{ sez.id }}" aria-labelledby="titolo-{{ r.id }}-{{ sez.id }}">
        <h2 id="titolo-{{ r.id }}-{{ sez.id }}">{{ sez.titolo }}</h2>
        {% if sez.descrizione %}<p class="descrizione">{{ sez.descrizione }}</p>{% endif %}
        {# Tabella di performance: variazioni colorate (verde = rialzo, rosso = ribasso) #}
        {% if sez.performance %}
        <div class="tabella-scorrevole">
          <table class="performance">
            {# "secondaria" = colonna nascosta sul telefono, per lasciare spazio alle variazioni #}
            <thead><tr><th>Commodity</th><th class="num">Ultimo</th><th>Unità</th><th class="secondaria">Data</th>
              <th class="num">1 sett.</th><th class="num">1 mese</th><th class="num">Da inizio anno</th><th class="num">1 anno</th><th class="secondaria">Fonte</th></tr></thead>
            <tbody>
              {% for p in sez.performance %}
              <tr>
                <td>{{ p.nome }}</td>
                {% if p.ok %}
                <td class="num">{{ p.valore }}</td>
                <td class="unita">{{ p.unita }}</td>
                <td class="secondaria{% if p.ritardo %} in-ritardo{% endif %}">{{ p.data }}</td>
                {% for v in p.variazioni %}<td class="num var{% if v.segno %} var-{{ v.segno }}{% endif %}">{{ v.testo }}</td>{% endfor %}
                <td class="secondaria">{{ p.fonte }}{% if p.nota_fonte %} <span class="stato-ritardo" title="{{ p.nota_fonte }}">ⓘ</span>{% endif %}</td>
                {% else %}
                <td colspan="8" class="stato-errore">⚠ non disponibile: {{ p.errore }}</td>
                {% endif %}
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% endif %}
        {% if sez.grafici %}
        <div class="griglia-grafici">
          {% for g in sez.grafici %}
          <article class="scheda-grafico{% if g.largo %} largo{% endif %}{% if g.alto %} alto{% endif %}">
            <header class="scheda-testa">
              <h3>{{ g.titolo }}</h3>
              {% if g.storico and g.json %}
              <div class="periodi" role="group" aria-label="Periodo del grafico">
                {% for p in ["1A", "5A", "10A", "Max"] %}
                <button type="button" data-grafico="{{ g.id }}" data-periodo="{{ p }}"
                        aria-pressed="{{ 'true' if p == g.periodo_iniziale else 'false' }}">{{ p }}</button>
                {% endfor %}
              </div>
              {% endif %}
            </header>
            {% if g.mancanti %}
            <p class="avviso-piccolo">⚠ Non disponibile:
              {% for m in g.mancanti %}{{ m.nome }} ({{ m.errore }}){{ ", " if not loop.last }}{% endfor %}</p>
            {% endif %}
            {% if g.json %}
            <div class="grafico" id="{{ g.id }}" data-periodo="{{ g.periodo_iniziale if g.storico else '' }}"
                 role="img" aria-label="Grafico: {{ g.titolo }}"></div>
            <script type="application/json" id="dati-{{ g.id }}">{{ g.json|safe }}</script>
            {% else %}
            <div class="grafico grafico-vuoto">Dati non disponibili per questo grafico.</div>
            {% endif %}
            <footer class="scheda-piede">
              {% if g.nota %}<p class="nota">{{ g.nota }}</p>{% endif %}
              {% if g.ultimi_dati %}
              <p class="ultimi">Ultimo dato:
                {% for u in g.ultimi_dati %}<span{% if u.ritardo %} class="in-ritardo"{% endif %}>{{ u.nome }} {{ u.data }}</span>{{ " · " if not loop.last }}{% endfor %}</p>
              {% endif %}
            </footer>
          </article>
          {% endfor %}
        </div>
        {% endif %}
      </section>
      {% endfor %}

      {# ---- Tabella di controllo: tutte le serie della regione ---- #}
      <section class="blocco" aria-labelledby="stato-{{ r.id }}">
        <details class="stato">
          <summary><h2 id="stato-{{ r.id }}">Stato delle serie ({{ r.stato|length }})</h2></summary>
          <div class="tabella-scorrevole">
            <table>
              <thead><tr><th>Serie</th><th>Codice</th><th>Fonte</th><th>Frequenza</th><th>Dal</th><th>Ultimo dato</th><th class="num">Valore</th><th>Stato</th></tr></thead>
              <tbody>
                {% for s in r.stato %}
                <tr>
                  <td>{{ s.nome }}</td>
                  <td><code>{{ s.id }}</code></td>
                  <td>{{ s.fonte }}{% if s.nota_fonte %} <span class="stato-ritardo" title="{{ s.nota_fonte }}">ⓘ</span>{% endif %}</td>
                  <td>{{ s.frequenza }}</td>
                  <td>{{ s.dal }}</td>
                  <td>{{ s.ultimo }}</td>
                  <td class="num">{{ s.valore }}</td>
                  <td>{% if not s.ok %}<span class="stato-errore">⚠ {{ s.errore }}</span>{% elif s.ritardo %}<span class="stato-ritardo">ⓘ in ritardo</span>{% else %}<span class="stato-ok">✓ ok</span>{% endif %}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </details>
      </section>
      {% endif %}
    </section>
    {% endfor %}
  </main>

  <footer class="piede contenitore">
    <p>Dati: Federal Reserve Bank of St. Louis (FRED), incluse le serie ICE BofA, Moody's, CBOE e NBER ivi pubblicate;
      Banca centrale europea (ECB Data Portal); Yahoo Finance (prezzi dei future sulle commodities, fonte non ufficiale),
      Fondo Monetario Internazionale via FRED (prezzi mensili di riserva); date delle recessioni dell'area euro: CEPR-EABCN Euro Area Business Cycle Dating Committee.
      Dashboard a scopo di studio, non è una consulenza finanziaria.</p>
  </footer>

  <script src="https://cdn.plot.ly/plotly-{{ plotly_versione }}.min.js" charset="utf-8"></script>
  <script src="https://cdn.plot.ly/plotly-locale-it-latest.js" charset="utf-8"></script>
  <script src="app.js?v={{ versione }}"></script>
</body>
</html>
